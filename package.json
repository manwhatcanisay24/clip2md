{
  "name": "clip2md",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-first browser extension that turns web articles into clean Markdown.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manwhatcanisay24/clip2md.git"
  },
  "homepage": "https://github.com/manwhatcanisay24/clip2md#readme",
  "bugs": "https://github.com/manwhatcanisay24/clip2md/issues",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && node scripts/verify-browser.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.5",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
